# ==============================================================
# AgriTech Backend Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# For production (Render), configure these in your Web Service dashboard
# ==============================================================

# Server Port (Render sets this dynamically in production)
PORT=5000

# Runtime Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/agritech
# Production (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agritech?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/agritech

# JSON Web Token (JWT) Secret & Expiration
# Replace with a strong, random 32+ character secret in production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Allowed Frontend Client Origin(s) for CORS
# Local: http://localhost:5173
# Production: https://your-agritech-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# External Meteorological Telemetry API (Open-Meteo)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
